cloud-provider-gcp:
  base_definition:
    traits:
      version:
        preprocess: 'inject-commit-hash'
      publish:
        dockerimages:
          cloud-provider-gcp:
            image: 'eu.gcr.io/gardener-project/kubernetes/cloud-provider-gcp'
            dockerfile: 'Dockerfile'
            target: cloud-provider-gcp
  jobs:
    head-update:
      traits:
        draft_release: ~
    pull-request:
      traits:
        pull-request: ~
        component_descriptor: ~
    release:
      traits:
        version:
          preprocess: 'finalize'
        release:
          nextversion: 'bump_minor'
        component_descriptor: ~
        publish:
          dockerimages:
            cloud-provider-gcp:
              tag_as_latest: true
